{
  "builds": [
    {
      "src": "Back-end/APIs/APIs.py",
      "use": "@vercel/python"
    },
    {
      "src":".html",
      "use":"@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "Back-end/APIs/APIs.py"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}